# ============================================
# OpenFlow XMP · 环境变量示例
# 复制为 .env 并按需修改；未配置则使用默认值
# 加载顺序：真实环境变量 > 本文件 > 默认值（见 admin/config.php）
# ============================================

# 运行环境：dev 显示错误详情，prod 只记日志（按访问域名 localhost 自动判定，一般无需设置）
# OF_ENV=dev

# 数据目录（JSON + SQLite 存储位置；容器化/多站点时建议显式指定）
# OF_DATA_DIR=/var/www/openflow/data

# 上传目录（媒体文件）
# OF_UPLOAD_DIR=/var/www/openflow/uploads

# 站点地址（部署后务必在后台「设置 → 站点配置」改为你的域名）
# SITE_URL=https://example.com

# ── 多租户（一台实例按域名切数据目录，默认关闭）──
# OF_MULTI_TENANT=1
# OF_TENANT_ROOT=/var/www/openflow/data/tenants
# OF_TENANT_UPLOAD_ROOT=/var/www/openflow/uploads/tenants

# deploy/sync-r2.py（Cloudflare R2；也接受 R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY 作为别名）
# R2_ENDPOINT=
# R2_KEY=
# R2_SECRET=
# R2_BUCKET=

# ── 部署目标（必填；缺失时 deploy/sync.sh 与 scripts/deploy.py 直接报错，不回落任何默认主机）──
# 本机私有配置：真实值只写这里，不提交、不写进文档、不写进示例
# OF_DEPLOY_HOST=
# OF_DEPLOY_USER=
# OF_DEPLOY_ROOT=
# OF_DEPLOY_PORT=22
# OF_DEPLOY_OPS_ROOT=        # sync.sh 同步 ops/ 的目标根（必须在 Web 根之外）
# OF_DEPLOY_SUDO=1
# OF_DEPLOY_OWNER=           # 站点根属主（远端 install 时使用）
# OF_DEPLOY_DATA_OWNER=      # data/ 属主（PHP 写入需要）

# ── 部署/CDN（sync.sh 会用 set -a 加载本文件；真实环境变量优先）──
# R2_* 用于 assets 变更时同步静态资源；缺失会让 deploy.py 以退出码 3 失败（不再静默跳过）
# R2_BUCKET=
# CF_TOKEN=       # Cloudflare API Token，需 Zone.Cache Purge 权限
# OF_CF_ZONE=     # Cloudflare Zone ID（purge 与 Worker 部署脚本都需要）
# OF_CF_ACCOUNT_ID=  # 仅 deploy/deploy-r2-media.py 与 deploy/deploy-uploads-r2.py 需要
# OF_GIT_PROXY=http://127.0.0.1:7890   # 可选：git push 走代理
# OF_GIT_PUSH_RETRIES=3
