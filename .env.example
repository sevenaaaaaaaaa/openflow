# ============================================
# OpenFlow XMP · 环境变量示例
# 复制为 .env 并按需修改；未配置则使用默认值
# ============================================

# 数据目录（JSON + SQLite 存储位置；容器化/多站点时建议显式指定）
# OF_DATA_DIR=/var/www/openflow/data

# 上传目录（媒体文件）
# OF_UPLOAD_DIR=/var/www/openflow/uploads

# 站点地址（部署后务必在后台「设置 → 站点配置」改为你的域名）
# SITE_URL=https://example.com
