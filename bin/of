#!/usr/bin/env php
<?php
/**
 * OpenFlow CLI — 命令行入口
 * 用法: php bin/of <command> [args...]
 *
 * 命令:
 *   articles list             列出文章
 *   articles create <title>   创建文章
 *   article get <id>          查看文章
 *   article publish <id>      发布文章
 *   pages list                列出页面
 *   members list              列出会员
 *   leads count               线索统计
 *   orders list               订单列表
 *   orders revenue            收入统计
 *   sentiment scan <topicId>  舆情采集
 *   cron run                  执行定时任务（发布/队列/订阅过期）
 *   search <q>                全局搜索
 *   topic add <name>          添加舆情监控主题
 *   list                      列出全部命令
 */

// CLI 模式：跳过 session 和登录
if (PHP_SAPI === 'cli') {
    $_SERVER['HTTP_HOST'] = 'cli.local';
}

require_once __DIR__ . '/../admin/config.php';
require_once __DIR__ . '/../lib/MemberSystem.php';
require_once __DIR__ . '/../lib/SentimentSystem.php';
require_once __DIR__ . '/../lib/Database.php';

function of_out(string $msg): void {
    global $OF_JSON;
    echo $OF_JSON ? json_encode(['message'=>$msg], JSON_UNESCAPED_UNICODE) . "\n" : $msg . "\n";
}
function of_json($data): void { echo json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE) . "\n"; }

// 全局 --json：让所有命令输出结构化 JSON（agent 友好，可被 shell 捕获）
$OF_JSON = false;
foreach ($argv as $a) if ($a === '--json') { $OF_JSON = true; break; }

$args = array_slice($argv, 1);
$args = array_values(array_filter($args, fn($a) => $a !== '--json'));
$cmd = $args[0] ?? 'list';
$params = array_slice($args, 1);

switch ($cmd) {
    // ─── articles（list/count/create，见下方完整实现）───
    case 'article':
        $sub = $params[0] ?? '';
        $id = $params[1] ?? '';
        if ($sub === 'get' && $id) {
            $a = get_article($id);
            of_json($a ?: ['error' => 'not found']);
        } elseif ($sub === 'publish' && $id) {
            $a = get_article($id);
            if ($a) { $a['status'] = 'published'; save_article($id, $a); of_out("已发布: {$a['title']}"); }
            else of_out("文章不存在");
        }
        break;

    // ─── pages ───
    case 'pages':
        $files = glob(PAGES_DIR . '/*.json');
        of_out("共 " . count($files) . " 个页面:");
        foreach ($files as $f) of_out("  " . basename($f, '.json'));
        break;

    // ─── members ───
    case 'members':
        $members = json_read(DATA_DIR . '/members/index.json');
        of_out("共 " . count($members) . " 位会员:");
        foreach ($members as $m) { $pts = $m['points'] ?? 0; of_out("  [{$m['id']}] {$m['name']} ({$m['email']}) 积分:{$pts}"); }
        break;

    // ─── leads ───
    case 'leads':
        $subs = json_read(DATA_DIR . '/submissions/index.json');
        of_json(['total' => count($subs)]);
        break;

    // ─── orders ───
    case 'orders':
        $sub = $params[0] ?? 'list';
        $orders = json_read(DATA_DIR . '/shop/orders.json');
        if ($sub === 'revenue') {
            $paid = array_filter($orders, fn($o) => ($o['status'] ?? '') === 'paid');
            $revenue = array_sum(array_map(fn($o) => (float)($o['amount'] ?? 0), $paid));
            of_json(['paid_orders' => count($paid), 'revenue' => round($revenue, 2)]);
        } else {
            of_out("共 " . count($orders) . " 笔订单:");
            foreach (array_slice($orders, 0, 10) as $o) of_out("  [{$o['id']}] {$o['course_title']} ¥{$o['amount']} ({$o['status']})");
        }
        break;

    // ─── sentiment ───
    case 'sentiment':
        $topicId = $params[0] ?? '';
        if ($topicId) {
            $r = sent_run_scan($topicId);
            of_json($r);
        } else {
            of_out("用法: php bin/of sentiment <topicId>");
        }
        break;

    // ─── topic ───
    case 'topic':
        $sub = $params[0] ?? 'list';
        if ($sub === 'add') {
            $name = $params[1] ?? '';
            if ($name) { sent_add_topic($name); of_out("已添加监控主题: {$name}"); }
            else of_out("用法: php bin/of topic add <名称>");
        } else {
            foreach (sent_topics() as $t) of_out("  [{$t['id']}] {$t['name']}");
        }
        break;

    // ─── cron ───
    case 'cron':
        require_once __DIR__ . '/../lib/AutomationSystem.php';
        require_once __DIR__ . '/../lib/SubscriptionSystem.php';
        // 定时发布
        $published = 0;
        foreach (get_articles() as $a) {
            if (($a['status'] ?? 'draft') === 'draft' && !empty($a['publish_at']) && $a['publish_at'] <= date('Y-m-d H:i:s')) {
                $a['status'] = 'published'; save_article($a['id'], $a); $published++;
            }
        }
        automation_process_queue();
        sub_expire_check();
        of_out("定时发布 {$published} 篇 · 队列/订阅已处理");
        break;

    // ─── search ───
    case 'search':
        $q = $params[0] ?? '';
        if (!$q) { of_out("用法: php bin/of search <关键词>"); break; }
        foreach (get_articles() as $a) {
            if (mb_strpos($a['title'] ?? '', $q) !== false) of_out("  文章: {$a['title']} [{$a['id']}]");
        }
        break;

    // ─── articles create（修复文档声明 vs 实现不一致；agent 常用写命令）───
    case 'articles':
        $sub = $params[0] ?? 'list';
        $articles = get_articles();
        if ($sub === 'create') {
            $title = $params[1] ?? '';
            if (!$title) { of_out("用法: php bin/of articles create <标题> [--json]"); break; }
            $id = 'article_' . date('YmdHis') . '_' . substr(bin2hex(random_bytes(4)), 0, 8);
            $slug = preg_replace('/[^a-z0-9\x{4e00}-\x{9fff}-]/u', '-', $title);
            $all = $articles; $all[] = ['id'=>$id,'title'=>$title,'slug'=>$slug,'content'=>'','status'=>'draft',
                'category'=>'insight','created_at'=>date('Y-m-d H:i:s'),'updated_at'=>date('Y-m-d H:i:s')];
            json_write(ARTICLES_DIR . '/index.json', $all);
            of_json(['ok'=>true,'id'=>$id,'title'=>$title]);
        } elseif ($sub === 'list') {
            if ($OF_JSON) { of_json(['total'=>count($articles)]); }
            else { of_out("共 " . count($articles) . " 篇文章:"); foreach (array_slice($articles, 0, 20) as $a) of_out("  [{$a['id']}] {$a['title']} ({$a['status']})"); }
        } elseif ($sub === 'count') { of_json(['total' => count($articles)]); }
        break;

    // ─── cdp tag（给画像打标签）───
    case 'cdp':
        $sub = $params[0] ?? '';
        if ($sub === 'tag') {
            $uid = $params[1] ?? ''; $tag = $params[2] ?? '';
            if (!$uid || !$tag) { of_out("用法: php bin/of cdp tag <visitor_id> <标签>"); break; }
            require_once __DIR__ . '/../lib/CdpSystem.php';
            $profiles = CdpSystem::allProfiles();
            if (isset($profiles[$uid])) { $profiles[$uid]['tags'][$tag] = ['type'=>'manual','by'=>'cli','at'=>date('Y-m-d H:i:s')]; CdpSystem::saveProfiles($profiles); of_json(['ok'=>true,'tagged'=>$uid,'tag'=>$tag]); }
            else of_json(['error'=>'not found','visitor_id'=>$uid]);
        } else { of_out("用法: php bin/of cdp tag <visitor_id> <标签>"); }
        break;

    // ─── flow run（触发流程事件，驱动自动化/画布）───
    case 'flow':
        $sub = $params[0] ?? '';
        if ($sub === 'run') {
            $ev = $params[1] ?? '';
            if (!$ev) { of_out("用法: php bin/of flow run <event>"); break; }
            require_once __DIR__ . '/../lib/FlowSystem.php';
            flow_handle($ev, []);
            of_json(['ok'=>true,'event'=>$ev]);
        } else { of_out("用法: php bin/of flow run <event>"); }
        break;

    default:
        of_out("OpenFlow CLI");
        of_out("用法: php bin/of <命令>");
        of_out("命令: articles / article / pages / members / leads / orders / sentiment / topic / cron / search");
}
