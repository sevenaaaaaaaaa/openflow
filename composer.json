{
    "name": "openflow/xmp",
    "description": "AI时代的网站增长操作系统 - OpenFlow XMP",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "lib/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:coverage": "vendor/bin/phpunit --coverage-html=coverage/",
        "test:verbose": "vendor/bin/phpunit --verbose"
    },
    "config": {
        "sort-packages": true
    }
}
