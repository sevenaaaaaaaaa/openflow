{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "*.php": { "runtime": "vercel-php@0.7.4" }
  },
  "rewrites": [
    { "source": "/docs", "destination": "/docs.php" },
    { "source": "/articles", "destination": "/articles.php" },
    { "source": "/article/:slug", "destination": "/article.php?slug=:slug" },
    { "source": "/authors/:slug", "destination": "/author.php?slug=:slug" },
    { "source": "/author/:name", "destination": "/author.php?name=:name" },
    { "source": "/courses", "destination": "/courses.php" },
    { "source": "/course/:slug", "destination": "/course-player.php?slug=:slug" },
    { "source": "/courses/:slug", "destination": "/course-player.php?slug=:slug" },
    { "source": "/about", "destination": "/about.php" },
    { "source": "/academy", "destination": "/academy.php" },
    { "source": "/community", "destination": "/community.php" },
    { "source": "/community-post/:id", "destination": "/community-post.php?id=:id" },
    { "source": "/pricing", "destination": "/pricing.php" },
    { "source": "/product", "destination": "/hub-products.php" },
    { "source": "/product/openflow", "destination": "/product.php" },
    { "source": "/capability", "destination": "/hub-capabilities.php" },
    { "source": "/capability/openflow", "destination": "/capability.php" },
    { "source": "/capability/:cap", "destination": "/hub-capabilities.php?cap=:cap" },
    { "source": "/changelog", "destination": "/changelog.php" },
    { "source": "/events", "destination": "/events.php" },
    { "source": "/events/:slug", "destination": "/event.php?slug=:slug" },
    { "source": "/topics", "destination": "/topics.php" },
    { "source": "/topics/:slug", "destination": "/topics.php?slug=:slug" },
    { "source": "/topic/:slug", "destination": "/topics.php?slug=:slug" },
    { "source": "/newsletter", "destination": "/newsletter.php" },
    { "source": "/cart", "destination": "/cart.php" },
    { "source": "/shop", "destination": "/shop.php" },
    { "source": "/pay", "destination": "/pay.php" },
    { "source": "/search", "destination": "/search.php" },
    { "source": "/help", "destination": "/help.php" },
    { "source": "/help/:slug", "destination": "/help-article.php?slug=:slug" },
    { "source": "/reviews", "destination": "/reviews.php" },
    { "source": "/survey", "destination": "/survey.php" },
    { "source": "/marketplace", "destination": "/marketplace.php" },
    { "source": "/tools", "destination": "/tools.php" },
    { "source": "/navigation", "destination": "/navigation.php" },
    { "source": "/navigation/submit", "destination": "/nav-submit.php" },
    { "source": "/navigation/compare", "destination": "/navigation-compare.php" },
    { "source": "/navigation/:id", "destination": "/navigation-site.php?site=:id" },
    { "source": "/developers", "destination": "/developers.php" },
    { "source": "/enterprise", "destination": "/enterprise.php" },
    { "source": "/account", "destination": "/member.php" },
    { "source": "/member", "destination": "/member.php" },
    { "source": "/register", "destination": "/member.php?view=register" },
    { "source": "/s/:token", "destination": "/share.php?t=:token" },
    { "source": "/thank-you", "destination": "/thank-you.php" },
    { "source": "/sitemap.xml", "destination": "/sitemap.php" },
    { "source": "/robots.txt", "destination": "/robots.php" },
    { "source": "/llms.txt", "destination": "/llms.php" },
    { "source": "/feed", "destination": "/feed.php" },
    { "source": "/rss.xml", "destination": "/feed.php" }
  ],
  "env": {
    "OF_ENV": "prod"
  }
}
