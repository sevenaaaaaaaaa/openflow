<IfModule mod_rewrite.c>
RewriteEngine On

# 首页：优先动态版 index.php（避免浏览器缓存旧 index.html）
DirectoryIndex index.php index.html
RewriteRule ^$ index.php [L,QSA]

# 多语言 URL 前缀（/en/ /ja/ /zh-CN/ 剥离 → 原路径，语言由 REQUEST_URI 检测）
RewriteRule ^(en|ja|zh-CN)/(.*)$ $2 [L,QSA]

# 融合方案：独立子路径挂载 /growth/（剥离前缀，OpenFlow 内容在既有站点子路径下共存）
RewriteRule ^growth/(.*)$ $1 [L,QSA]

# 静态资源缓存（带版本号的资源可长缓存）
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|gif|svg|webp|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# 后台管理 · 美化 URL
RewriteRule ^login/?$ admin/login.php [L]
# ── 浅 CRUD 归并：旧页 301 到父页对应子 tab（B3）──
RewriteRule ^xmp/page-categories/?$  /xmp/content-hub?tab=pages&sub=cats [R=301,L,NE]
RewriteRule ^xmp/tags/?$             /xmp/content-hub?tab=pages&sub=tags [R=301,L,NE]
RewriteRule ^xmp/payment-settings/?$ /xmp/shop-settings?sub=pay          [R=301,L,NE]
RewriteRule ^xmp/mail-settings/?$    /xmp/email?sub=smtp                 [R=301,L,NE]
RewriteRule ^xmp/footer-links/?$     /xmp/site-builder?sub=foot          [R=301,L,NE]
RewriteRule ^xmp/storage/?$          /xmp/health-check?sub=stor          [R=301,L,NE]
RewriteRule ^xmp/activity/?$         /xmp/audit-log?sub=act              [R=301,L,NE]

# ── 内容中心：旧的 4 个独立页 301 到统一入口对应 tab（B2）──
RewriteRule ^xmp/articles/?$   /xmp/content-hub?tab=articles  [R=301,L,NE]
RewriteRule ^xmp/pages-list/?$ /xmp/content-hub?tab=pages      [R=301,L,NE]
RewriteRule ^xmp/downloads/?$  /xmp/content-hub?tab=downloads  [R=301,L,NE]
RewriteRule ^xmp/podcasts/?$   /xmp/content-hub?tab=podcasts   [R=301,L,NE]

# ── SEO 中心：旧的 7 个独立页 301 到统一入口对应 tab（B1）──
RewriteRule ^xmp/seo/?$            /xmp/seo-center?tab=pages      [R=301,L,NE]
RewriteRule ^xmp/seo-tools/?$      /xmp/seo-center?tab=tools      [R=301,L,NE]
RewriteRule ^xmp/seo-batch/?$      /xmp/seo-center?tab=batch      [R=301,L,NE]
RewriteRule ^xmp/seo-console/?$    /xmp/seo-center?tab=console    [R=301,L,NE]
RewriteRule ^xmp/structured-data/?$ /xmp/seo-center?tab=structured [R=301,L,NE]
RewriteRule ^xmp/image-seo/?$      /xmp/seo-center?tab=images     [R=301,L,NE]
RewriteRule ^xmp/redirects/?$      /xmp/seo-center?tab=redirects  [R=301,L,NE]

RewriteRule ^xmp/?$ admin/index.php [L]
RewriteRule ^xmp/([a-z0-9-]+)/?$ admin/$1.php [L,QSA]
RewriteRule ^xmp/(.+)$ admin/$1 [L,QSA]

# 主站页面（伪静态 · 去掉 .php 后缀）
# 放在「已存在文件/目录放行」之前，避免 docs 目录冲突
RewriteRule ^docs/?$ docs.php [L,QSA]
RewriteRule ^academy/?$ academy.php [L,QSA]
RewriteRule ^community/?$ community.php [L,QSA]
RewriteRule ^tools/?$ tools.php [L,QSA]
RewriteRule ^marketplace/?$ marketplace.php [L,QSA]
RewriteRule ^articles/?$ articles.php [L,QSA]
RewriteRule ^courses/?$ courses.php [L,QSA]
RewriteRule ^about/?$ about.php [L,QSA]
RewriteRule ^product/?$ product.php [L,QSA]
RewriteRule ^capability/?$ capability.php [L,QSA]
RewriteRule ^downloads/?$ downloads.php [L,QSA]
RewriteRule ^podcasts/?$ podcasts.php [L,QSA]
RewriteRule ^survey/?$ survey.php [L,QSA]
RewriteRule ^reviews/?$ reviews.php [L,QSA]
RewriteRule ^topics/?$ topics.php [L,QSA]
RewriteRule ^consultation/?$ consultation.php [L,QSA]
# 会员中心：前台壳子与 7 个页面都链到 /account（以前没有这条规则，全部 404）
RewriteRule ^account/?$ member.php [L,QSA]
RewriteRule ^member/?$ member.php [L,QSA]
RewriteRule ^register/?$ member.php?view=register [L,QSA]
RewriteRule ^course/(.+)$ course-player.php?slug=$1 [L,QSA]
RewriteRule ^courses/(.+)$ course-player.php?slug=$1 [L,QSA]
RewriteRule ^download/(.+)$ download.php?slug=$1 [L,QSA]
RewriteRule ^downloads/(.+)$ download.php?slug=$1 [L,QSA]
RewriteRule ^category/([a-z]+)/([a-z0-9_-]+)/?$ category.php?section=$1&subkey=$2 [L,QSA]
RewriteRule ^community-post/(.+)$ community-post.php?id=$1 [L,QSA]
# 生态资产详情伪静态（asset.php 头部注释里承诺了这条路径，但一直没有规则；个人中心「为你推荐」链到这里 → 404）
RewriteRule ^(skill|plugin|theme)/([^/]+)/?$ asset.php?type=$1&id=$2 [L,QSA,B]

# API：前台脚本用无后缀形式请求（/api/member?action=login）。以前没有这条规则，
# 服务器不开 MultiViews 时全部 404 —— 登录 / 注册弹窗提交后直接失败。
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^api/([a-z0-9_-]+)/?$ api/$1.php [L,QSA]

# 已存在的文件/目录直接放行
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SEO 文件
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^llms\.txt$ llms.php [L]
RewriteRule ^(feed|rss)(\.xml)?$ feed.php [L]

# 前台内容
RewriteRule ^articles/(.+)$ article.php?slug=$1 [L,QSA,B]
RewriteRule ^article/(.+)$ article.php?slug=$1 [L,QSA,B]
RewriteRule ^authors/(.+)$ author.php?slug=$1 [L,QSA,B]
RewriteRule ^author/(.+)$ author.php?name=$1 [L,QSA,B]
RewriteRule ^topic/(.+)$ topics.php?slug=$1 [L,QSA,B]
RewriteRule ^topics/(.+)$ topics.php?slug=$1 [L,QSA,B]
RewriteRule ^navigation/?$ navigation.php [L,QSA]
RewriteRule ^navigation-site/?$ navigation-site.php [L,QSA]
# 增长导航站点详情：导航页每张站点卡都链到 /navigation/{id}，此前没有规则 → 全部 404
RewriteRule ^navigation/([^/]+)/?$ navigation-site.php?site=$1 [L,QSA,B]
RewriteRule ^event/(.+)$ event.php?slug=$1 [L,QSA,B]
RewriteRule ^events/?$ events.php [L,QSA]
RewriteRule ^events/(.+)$ event.php?slug=$1 [L,QSA,B]
RewriteRule ^lp/(.+)$ landing.php?slug=$1 [L,QSA,B]
RewriteRule ^b/(.+)$ front-builder.php?slug=$1 [L,QSA,B]

# 功能页
RewriteRule ^search$ search.php [L,QSA]
RewriteRule ^thank-you/?$ thank-you.php [L,QSA]
RewriteRule ^activate/?$ activate.php [L,QSA]
RewriteRule ^shop/?$ shop.php [L,QSA]
RewriteRule ^pay/?$ pay.php [L,QSA]

# 自定义内容类型（CPT）前台：归档 /c/{type}，单条 /c/{type}/{slug}
RewriteRule ^c/([a-z0-9-]+)/(.+)$ cpt-view.php?type=$1&slug=$2 [L,QSA,B]
RewriteRule ^c/([a-z0-9-]+)/?$ cpt-archive.php?type=$1 [L,QSA]

# Landing 聚合页（单段 slug）
RewriteRule ^([a-z0-9][a-z0-9-]*)/?$ landing.php?slug=$1 [L,QSA]
</IfModule>
